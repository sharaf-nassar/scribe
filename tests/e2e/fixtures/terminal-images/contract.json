      "expect": "opaque_red_six_pixel_column"
    },
    {
      "id": "sixel-c1-transparent",
      "path": "fixtures/terminal-images/sixel-c1-transparent.hex",
      "encoding": "hex",
      "expect": "transparent_background_red_six_pixel_column"
    },
    {
      "id": "sixel-mode-chronology",
      "path": "fixtures/terminal-images/sixel-mode-chronology.hex",
      "encoding": "hex",
      "expect": "xterm_80_8452_cursor_and_text_order"
    },
    {
      "id": "malformed-recovery",
      "path": "fixtures/terminal-images/malformed-recovery.hex",
      "encoding": "hex",
      "expect": "can_sub_abort_and_adjacent_text_survives"
    }
  ]
}
