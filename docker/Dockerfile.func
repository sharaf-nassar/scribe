FROM debian:trixie-slim AS beads-release
ARG TARGETARCH
ADD https://github.com/gastownhall/beads/releases/download/v1.1.0/beads_1.1.0_linux_${TARGETARCH}.tar.gz \
    /tmp/beads.tar.gz
RUN tar -xzf /tmp/beads.tar.gz -C /usr/local/bin bd

FROM rust:1.95-trixie AS func-runtime

COPY --from=beads-release /usr/local/bin/bd /usr/local/bin/bd

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        fonts-jetbrains-mono \
        ca-certificates \
        clang \
        dbus \
        dbus-x11 \
        fish \
        gnome-keyring \
        libdbus-1-3 \
        libfontconfig-dev \
        libssl-dev \
        libvulkan1 \
        libwayland-dev \
        libx11-xcb-dev \
        libxkbcommon-x11-dev \
        libzstd-dev \
        # terminal-images-functional.sh proves that graphics escapes and their
        # replies survive an SSH pty unchanged, which needs a real sshd and
        # client on loopback inside the container.
        openssh-client \
        openssh-server \
        zsh \
    && rm -rf /var/lib/apt/lists/*

ARG BIN_DIR=target/e2e-stage/release

COPY ${BIN_DIR}/scribe-server /usr/local/bin/scribe-server
COPY ${BIN_DIR}/scribe-test /usr/local/bin/scribe-test
COPY ${BIN_DIR}/scribe-cli /usr/local/bin/scribe
COPY ${BIN_DIR}/scribe-cli /usr/local/bin/scribe-cli
# AI state, prompt text, and context-window % reach the server over the hook
# channel (spec 003, FR-020..FR-022) — OSC 1337 no longer carries them. The
# `ai-state-indicator` / `ai-context-thresholds` e2e tests drive that channel by
# running the helper inside the session shell, where scribe-server exports
# SCRIBE_HOOK_SOCK and SCRIBE_SESSION_ID.
COPY ${BIN_DIR}/scribe-hook-helper /usr/local/bin/scribe-hook-helper
# Shell-integration scripts: scribe-server's `find_scripts_dir()` resolves
# `<exe_dir>/../share/<flavor>/shell-integration`, i.e. `/usr/local/share/scribe/shell-integration`
# for this container's `/usr/local/bin/scribe-server` (stable flavor). Without
# this copy the `shell-integration.sh` e2e test times out at Phase 1 waiting
# for `SCRIBE_SHELL_INTEGRATION=1`.
COPY dist/shell-integration /usr/local/share/scribe/shell-integration
COPY dist/ai-hook-codex.sh /usr/local/share/scribe/ai-hook-codex.sh
COPY docker/entrypoint-func.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh /usr/local/bin/scribe-server /usr/local/bin/scribe-test \
    /usr/local/bin/scribe /usr/local/bin/scribe-cli /usr/local/bin/scribe-hook-helper \
    /usr/local/share/scribe/ai-hook-codex.sh

RUN mkdir -p /output

ENTRYPOINT ["/entrypoint.sh"]

FROM func-runtime AS beads-write-unit
RUN apt-get update && \
    apt-get install -y --no-install-recommends libdbus-1-dev pkg-config && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/workspace/target \
    cargo test --locked -p scribe-server beads_board::tests -- --nocapture && \
    cargo test --locked -p scribe-server \
        beads_board_refresh_reaches_each_authorized_same_root_workspace -- --nocapture && \
    cargo test --locked -p scribe-client beads -- --nocapture

# The read-slice proof needs the real GPUI window and the same official bd used
# by the functional harness.
FROM scribe-test-visual AS beads-read-e2e
COPY --from=beads-release /usr/local/bin/bd /usr/local/bin/bd
COPY --chmod=755 tests/e2e/func/beads-board-visual-entrypoint.sh /entrypoint-beads.sh
ENTRYPOINT ["/entrypoint-beads.sh"]
