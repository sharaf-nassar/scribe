diff --git a/cmd/bd/guarded_lifecycle_embedded_test.go b/cmd/bd/guarded_lifecycle_embedded_test.go
new file mode 100644
index 00000000..c13688af
--- /dev/null
+++ b/cmd/bd/guarded_lifecycle_embedded_test.go
@@ -0,0 +1,101 @@
+//go:build cgo
+
+package main
+
+import (
+	"errors"
+	"os"
+	"os/exec"
+	"strings"
+	"testing"
+
+	"github.com/steveyegge/beads/internal/types"
+)
+
+func guardedCommandFailure(t *testing.T, bd, dir string, args ...string) int {
+	t.Helper()
+	cmd := exec.Command(bd, args...)
+	cmd.Dir = dir
+	cmd.Env = bdEnv(dir)
+	out, err := cmd.CombinedOutput()
+	if err == nil {
+		t.Fatalf("bd %v succeeded, want guard mismatch\n%s", args, out)
+	}
+	var exitErr *exec.ExitError
+	if !errors.As(err, &exitErr) {
+		t.Fatalf("bd %v failed without exit code: %v\n%s", args, err, out)
+	}
+	return exitErr.ExitCode()
+}
+
+func TestGuardedLifecycleCLI(t *testing.T) {
+	if os.Getenv("BEADS_TEST_EMBEDDED_DOLT") != "1" {
+		t.Skip("set BEADS_TEST_EMBEDDED_DOLT=1 to run embedded dolt integration tests")
+	}
+
+	bd := buildEmbeddedBD(t)
+	dir, _, _ := bdInit(t, bd, "--prefix", "gl")
+
+	t.Run("claim keeps native actor and lease semantics", func(t *testing.T) {
+		issue := bdCreate(t, bd, dir, "Guarded claim", "--type", "task")
+		bdUpdate(t, bd, dir, issue.ID, "--actor", "local-actor", "--claim",
+			"--if-status", "open", "--if-assignee", "")
+		got := bdShow(t, bd, dir, issue.ID)
+		if got.Status != types.StatusInProgress || got.Assignee != "local-actor" || got.LeaseExpiresAt == nil {
+			t.Fatalf("guarded claim = status %q, assignee %q, lease %v", got.Status, got.Assignee, got.LeaseExpiresAt)
+		}
+	})
+
+	t.Run("label-only update is guarded atomically", func(t *testing.T) {
+		issue := bdCreate(t, bd, dir, "Guarded labels", "--type", "task")
+		bdUpdate(t, bd, dir, issue.ID, "--set-labels", "one,two",
+			"--if-status", "open", "--if-assignee", "")
+		got := bdShow(t, bd, dir, issue.ID)
+		if len(got.Labels) != 2 || got.Labels[0] != "one" || got.Labels[1] != "two" {
+			t.Fatalf("guarded labels = %v, want [one two]", got.Labels)
+		}
+	})
+
+	t.Run("comment append is guarded atomically", func(t *testing.T) {
+		issue := bdCreate(t, bd, dir, "Guarded comment", "--type", "task")
+		if out, err := bdRunWithFlockRetry(t, bd, dir, "comments", "add", issue.ID,
+			"guarded comment", "--if-status", "open", "--if-assignee", ""); err != nil {
+			t.Fatalf("guarded comment failed: %v\n%s", err, out)
+		}
+		if code := guardedCommandFailure(t, bd, dir, "comments", "add", issue.ID,
+			"must not land", "--if-status", "closed", "--if-assignee", ""); code != ExitGuardMismatch {
+			t.Fatalf("stale guarded comment exit = %d, want %d", code, ExitGuardMismatch)
+		}
+		out, err := bdRunWithFlockRetry(t, bd, dir, "comments", issue.ID, "--json")
+		if err != nil {
+			t.Fatalf("list comments: %v\n%s", err, out)
+		}
+		if !strings.Contains(string(out), "guarded comment") || strings.Contains(string(out), "must not land") {
+			t.Fatalf("guarded comment thread = %s", out)
+		}
+	})
+
+	t.Run("close and reopen preserve native lifecycle", func(t *testing.T) {
+		issue := bdCreate(t, bd, dir, "Guarded close", "--type", "task", "--defer", "2030-01-01")
+		bdClose(t, bd, dir, issue.ID, "--reason", "guarded reason",
+			"--if-status", "deferred", "--if-assignee", "")
+		closed := bdShow(t, bd, dir, issue.ID)
+		if closed.Status != types.StatusClosed || closed.ClosedAt == nil || closed.CloseReason != "guarded reason" {
+			t.Fatalf("guarded close = status %q, closed_at %v, reason %q", closed.Status, closed.ClosedAt, closed.CloseReason)
+		}
+
+		if code := guardedCommandFailure(t, bd, dir, "reopen", issue.ID,
+			"--if-status", "open", "--if-assignee", ""); code != ExitGuardMismatch {
+			t.Fatalf("stale guarded reopen exit = %d, want %d", code, ExitGuardMismatch)
+		}
+		if out, err := bdRunWithFlockRetry(t, bd, dir, "reopen", issue.ID,
+			"--if-status", "closed", "--if-assignee", ""); err != nil {
+			t.Fatalf("guarded reopen failed: %v\n%s", err, out)
+		}
+		reopened := bdShow(t, bd, dir, issue.ID)
+		if reopened.Status != types.StatusOpen || reopened.ClosedAt != nil || reopened.CloseReason != "" || reopened.DeferUntil != nil {
+			t.Fatalf("guarded reopen = status %q, closed_at %v, reason %q, defer %v",
+				reopened.Status, reopened.ClosedAt, reopened.CloseReason, reopened.DeferUntil)
+		}
+	})
+}
