FROM rust:1.95-trixie

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        fonts-jetbrains-mono \
        fonts-noto-color-emoji \
        fonts-noto-cjk \
        ca-certificates \
        clang \
        git \
        libfontconfig-dev \
        python3 \
        # The notification E2E stands a real freedesktop notification service on
        # the session bus (tests/e2e/visual/notify-daemon.py) so the client's
        # zbus dispatcher is talking to an actual D-Bus name, and the drag-drop
        # E2E drives a real XDND source (tests/e2e/visual/xdnd-drop.py) so the
        # client's drop handler is fed by the X server rather than a synthetic
        # event. Those two need python's D-Bus/GLib and Xlib bindings.
        python3-dbus \
        python3-gi \
        python3-xlib \
        gir1.2-glib-2.0 \
        sqlite3 \
        xvfb \
        mesa-utils \
        libgl1-mesa-dri \
        libegl1 \
        libgles2 \
        libgbm1 \
        libvulkan1 \
        libwayland-dev \
        libwayland-client0 \
        libx11-xcb-dev \
        libxcb1 \
        libxcb-render0 \
        libxcb-shape0 \
        libxcb-xfixes0 \
        libxcb-cursor0 \
        libxkbcommon-x11-0 \
        libxkbcommon-x11-dev \
        xkb-data \
        libzstd-dev \
        libssl-dev \
        mesa-vulkan-drivers \
        scrot \
        imagemagick \
        xdotool \
        x11-utils \
        xclip \
        openbox \
        libwebkit2gtk-4.1-0 \
        dbus-x11 \
        xdg-desktop-portal \
        xdg-desktop-portal-gtk \
        gnome-keyring \
        ibus \
        ibus-table \
        ibus-table-cangjie3 \
        # The pinned terminal-image application corpus
        # (specs/020-terminal-images/contract.md) is built here, and the SSH
        # half of that corpus needs a real sshd in the container.
        file \
        openssh-server \
        # The settings-trust E2E builds a synthetic physical LAN inside the
        # container's own (still `--network none`) netns so the production
        # network-fingerprint gate has a real route/neighbour pair to read.
        iproute2 \
        xz-utils \
        libglib2.0-dev \
        libpng-dev \
        libjpeg-dev \
        libwebp-dev \
        libtiff-dev \
        libgd-dev \
        libreadline-dev \
    && rm -rf /var/lib/apt/lists/*

# Pin the truthful application compatibility corpus.
#
# Debian trixie ships Chafa 1.14.5 and gnuplot 6.0.2 and no Yazi at all, so the
# exact contract versions are fetched and checksum-verified here instead. Every
# artifact is pinned by sha256; a silently republished upstream tarball fails
# the build rather than changing what the corpus proves. gnuplot is configured
# with libgd, which is what supplies the `sixelgd` terminal the plotting
# workflow drives.
ARG YAZI_VERSION=26.5.6
ARG YAZI_SHA256=1c9096f0a83b8102c194385f644cdeff93cc8269426163c9d033041ebd537bd2
ARG CHAFA_VERSION=1.18.2
ARG CHAFA_SHA256=0b8d9ba9f347e8b6c0c71878217c9b0e478b4a42aa4babea0bf20840567239c2
ARG GNUPLOT_VERSION=6.0.3
ARG GNUPLOT_SHA256=ec52e3af8c4083d4538152b3f13db47f6d29929a3f6ecec5365c834e77f251ab
RUN set -eux; \
    mkdir -p /tmp/corpus; cd /tmp/corpus; \
    curl -fsSL -o yazi.zip \
        "https://github.com/sxyazi/yazi/releases/download/v${YAZI_VERSION}/yazi-x86_64-unknown-linux-gnu.zip"; \
    echo "${YAZI_SHA256}  yazi.zip" | sha256sum -c -; \
    python3 -c "import zipfile; zipfile.ZipFile('yazi.zip').extractall('.')"; \
    install -m 0755 "yazi-x86_64-unknown-linux-gnu/yazi" \
        "yazi-x86_64-unknown-linux-gnu/ya" /usr/local/bin/; \
    curl -fsSL -o chafa.tar.xz \
        "https://github.com/hpjansson/chafa/releases/download/${CHAFA_VERSION}/chafa-${CHAFA_VERSION}.tar.xz"; \
    echo "${CHAFA_SHA256}  chafa.tar.xz" | sha256sum -c -; \
    tar xf chafa.tar.xz; cd "chafa-${CHAFA_VERSION}"; \
    ./configure --prefix=/usr/local --without-imagemagick >/dev/null; \
    make -j"$(nproc)" >/dev/null; make install >/dev/null; ldconfig; cd /tmp/corpus; \
    curl -fsSL -o gnuplot.tar.gz \
        "https://downloads.sourceforge.net/project/gnuplot/gnuplot/${GNUPLOT_VERSION}/gnuplot-${GNUPLOT_VERSION}.tar.gz"; \
    echo "${GNUPLOT_SHA256}  gnuplot.tar.gz" | sha256sum -c -; \
    tar xf gnuplot.tar.gz; cd "gnuplot-${GNUPLOT_VERSION}"; \
    ./configure --prefix=/usr/local --without-x --without-qt --without-wx \
        --without-latex --with-gd >/dev/null; \
    make -j"$(nproc)" >/dev/null; make install >/dev/null; \
    cd /; rm -rf /tmp/corpus; \
    yazi --version; \
    chafa --version | head -1; \
    gnuplot --version; \
    gnuplot -e 'set print "-"; print GPVAL_TERMINALS' 2>&1 | grep -qw sixelgd

# Force visual E2E onto lavapipe's software Vulkan ICD for deterministic
# rendering on CI runners without a usable hardware driver. lavapipe ships in
# mesa-vulkan-drivers; pinning VK_ICD_FILENAMES skips any hardware ICD probe so
# the GPUI client renders identically across runs and machines.
ENV VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/lvp_icd.x86_64.json

# Silence GPUI open/close and cursor-blink animations so consecutive
# screenshots are byte-identical. Harmless on the current display-only spike
# (no animations yet); forward-compatible with the animated client.
ENV SCRIBE_DISABLE_ANIMATIONS=1

ARG BIN_DIR=target/e2e-stage/release

COPY ${BIN_DIR}/scribe-server /usr/local/bin/scribe-server
COPY ${BIN_DIR}/scribe-client /usr/local/bin/scribe-client
COPY ${BIN_DIR}/scribe-test /usr/local/bin/scribe-test
# The AI hook channel is the only way a provider event (task label, state,
# context %) reaches the server, so a visual test that needs one drives the real
# helper instead of hand-forging a frame.
COPY ${BIN_DIR}/scribe-hook-helper /usr/local/bin/scribe-hook-helper
COPY docker/entrypoint-visual.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh \
    /usr/local/bin/scribe-server \
    /usr/local/bin/scribe-client \
    /usr/local/bin/scribe-test \
    /usr/local/bin/scribe-hook-helper

RUN mkdir -p /output

ENTRYPOINT ["/entrypoint.sh"]
