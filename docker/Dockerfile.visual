FROM rust:1.95-trixie

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        fonts-jetbrains-mono \
        fonts-noto-color-emoji \
        fonts-noto-cjk \
        ca-certificates \
        clang \
        git \
        libfontconfig-dev \
        python3 \
        # The notification E2E stands a real freedesktop notification service on
        # the session bus (tests/e2e/visual/notify-daemon.py) so the client's
        # zbus dispatcher is talking to an actual D-Bus name, and the drag-drop
        # E2E drives a real XDND source (tests/e2e/visual/xdnd-drop.py) so the
        # client's drop handler is fed by the X server rather than a synthetic
        # event. Those two need python's D-Bus/GLib and Xlib bindings.
        python3-dbus \
        python3-gi \
        python3-xlib \
        gir1.2-glib-2.0 \
        sqlite3 \
        xvfb \
        mesa-utils \
        libgl1-mesa-dri \
        libegl1 \
        libgles2 \
        libgbm1 \
        libvulkan1 \
        libwayland-dev \
        libwayland-client0 \
        libx11-xcb-dev \
        libxcb1 \
        libxcb-render0 \
        libxcb-shape0 \
        libxcb-xfixes0 \
        libxcb-cursor0 \
        libxkbcommon-x11-0 \
        libxkbcommon-x11-dev \
        xkb-data \
        libzstd-dev \
        libssl-dev \
        mesa-vulkan-drivers \
        scrot \
        imagemagick \
        xdotool \
        x11-utils \
        xclip \
        openbox \
        libwebkit2gtk-4.1-0 \
        dbus-x11 \
        gnome-keyring \
        ibus \
        ibus-table \
        ibus-table-cangjie3 \
    && rm -rf /var/lib/apt/lists/*

# Force visual E2E onto lavapipe's software Vulkan ICD for deterministic
# rendering on CI runners without a usable hardware driver. lavapipe ships in
# mesa-vulkan-drivers; pinning VK_ICD_FILENAMES skips any hardware ICD probe so
# the GPUI client renders identically across runs and machines.
ENV VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/lvp_icd.x86_64.json

# Silence GPUI open/close and cursor-blink animations so consecutive
# screenshots are byte-identical. Harmless on the current display-only spike
# (no animations yet); forward-compatible with the animated client.
ENV SCRIBE_DISABLE_ANIMATIONS=1

ARG BIN_DIR=target/e2e-stage/release

COPY ${BIN_DIR}/scribe-server /usr/local/bin/scribe-server
COPY ${BIN_DIR}/scribe-client /usr/local/bin/scribe-client
COPY ${BIN_DIR}/scribe-test /usr/local/bin/scribe-test
# The AI hook channel is the only way a provider event (task label, state,
# context %) reaches the server, so a visual test that needs one drives the real
# helper instead of hand-forging a frame.
COPY ${BIN_DIR}/scribe-hook-helper /usr/local/bin/scribe-hook-helper
COPY docker/entrypoint-visual.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh \
    /usr/local/bin/scribe-server \
    /usr/local/bin/scribe-client \
    /usr/local/bin/scribe-test \
    /usr/local/bin/scribe-hook-helper

RUN mkdir -p /output

ENTRYPOINT ["/entrypoint.sh"]
